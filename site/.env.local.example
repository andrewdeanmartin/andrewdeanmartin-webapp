# Copy to site/.env.local — never commit .env.local
# Local dev defaults below; add production values for prod E2E / admin scripts.

B9_JWT_SECRET=change-me-local-dev-secret
B9_ACCESS_PASSWORD=b9local
ADM_PRIVATE_SECRET=unused-for-b9-local

# Production (Vercel dashboard → Environment Variables)
# B9_E2E_PASSWORD=          # B9_ACCESS_PASSWORD or B9_PETE_PASSWORD from Vercel
# B9_ADMIN_PASSWORD=        # optional — for /b9/admin login + reset script

# Production (Render → b9-transform-api → ADMIN_API_KEY)
# B9_ADMIN_API_KEY=         # preferred for scripts/b9-reset-data.mjs --target prod
