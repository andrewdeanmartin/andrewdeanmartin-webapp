{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "andrewdeanmartin.com" }],
      "destination": "https://www.andrewdeanmartin.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/b9-api/:path*",
      "destination": "https://b9-transform-api.onrender.com/:path*"
    }
  ],
  "headers": [
    {
      "source": "/b9/service-worker.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/b9/" }
      ]
    },
    {
      "source": "/b9/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" }
      ]
    }
  ],
  "cleanUrls": true
}
